# Database (change both passwords before EC2 deployment)
DB_NAME=good_morning
DB_USERNAME=good_morning
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-root-password
DB_PORT=3306

# Spring Boot / Flyway
SPRING_PROFILES_ACTIVE=demo

# Object storage: self-hosted MinIO (S3-compatible) in this Compose project.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are the MinIO root credentials, also used by the backend.
# Change both before EC2 deployment (the secret must be at least 8 characters).
AWS_REGION=ap-southeast-2
# Bucket name: lowercase letters, digits, "." and "-". Must not be api, grafana, assets, backgrounds, data or healthz
# (Nginx serves the bucket at /<bucket>/ on the same origin as the site).
AWS_S3_BUCKET=taipei-code-fest-assets
AWS_ACCESS_KEY_ID=change-me-access-key
AWS_SECRET_ACCESS_KEY=change-me-secret-key
# Public URL browsers use to open images: the same origin as the site (the ALB URL), no trailing slash.
# Use https:// if the ALB has a TLS listener.
S3_PUBLIC_ENDPOINT=http://localhost
PRESIGNED_URL_TTL=PT15M

# Monitoring
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
LOKI_RETENTION=168h
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Local default. On EC2 set the public ALB URL, including /grafana/ and trailing slash.
GRAFANA_ROOT_URL=http://localhost/grafana/
